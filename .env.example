# Copy to .env for local overrides (tracked example only — no secrets here).
# Booker demo creds (admin / password123) are public training creds and stay
# inside lib/data.js (DEMO_CREDS); do not put private tokens in this file.
BASE_URL=https://restful-booker.herokuapp.com
# Local self-host default (see config/environments.json):
# BASE_URL=http://localhost:3001
# Load-profile guard: tests/load.js refuses any non-localhost BASE_URL unless
# explicitly opted in (public budgets apply: <=5 VUs, <=300 req/run, read-only):
# ALLOW_PUBLIC_LOAD=true
# Think time (seconds) between requests inside the smoke VU:
THINK_TIME=1
